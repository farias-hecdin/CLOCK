<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="64.0sp"
        android:gravity="center"
        android:id="@id/stopwatch_time"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24.0dip"
        android:singleLine="true"
        android:fontFamily="sans-serif-thin"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="24.0sp"
        android:autoSizeMaxTextSize="64.0sp" />
    <TextView
        android:textStyle="italic"
        android:gravity="center"
        android:id="@id/empty_laps"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16.0dip"
        android:text="@string/no_laps"
        style="@android:style/TextAppearance.Medium" />
    <ListView
        android:id="@id/laps_list"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1.0" />
    <TextView
        android:textSize="14.0sp"
        android:layout_gravity="center_horizontal"
        android:id="@id/sw_clear_laps"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/clear_laps"
        style="?android:buttonBarButtonStyle" />
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="92.0dip">
        <ImageButton
            android:id="@id/sw_reset"
            android:background="@drawable/circle_btn"
            android:padding="14.0dip"
            android:layout_width="64.0dip"
            android:layout_height="64.0dip"
            android:layout_marginLeft="16.0dip"
            android:layout_marginRight="16.0dip"
            android:src="@drawable/ic_replay"
            android:contentDescription="@string/reset"
            android:elevation="6.0dip" />
        <ImageButton
            android:id="@id/sw_start_pause"
            android:background="@drawable/circle_btn"
            android:padding="14.0dip"
            android:layout_width="64.0dip"
            android:layout_height="64.0dip"
            android:layout_marginLeft="16.0dip"
            android:layout_marginRight="16.0dip"
            android:src="@drawable/ic_play_arrow"
            android:contentDescription="@string/start"
            android:elevation="6.0dip" />
        <ImageButton
            android:id="@id/sw_lap"
            android:background="@drawable/circle_btn"
            android:padding="14.0dip"
            android:layout_width="64.0dip"
            android:layout_height="64.0dip"
            android:layout_marginLeft="16.0dip"
            android:layout_marginRight="16.0dip"
            android:src="@drawable/ic_flag"
            android:contentDescription="@string/lap"
            android:elevation="6.0dip" />
    </LinearLayout>
</LinearLayout>