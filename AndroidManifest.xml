<?xml version="1.0" encoding="utf-8"?>
<manifest
    android:compileSdkVersion="36"
    android:compileSdkVersionCodename="16"
    package="com.angrydoughnuts.android.alarmclock"
    platformBuildVersionCode="36"
    platformBuildVersionName="16"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Permite que la aplicación impida que el teléfono entre en modo de suspensión. -->
    <uses-permission
        android:name="android.permission.WAKE_LOCK" />
    <!-- Permite que la aplicación lea archivos de audio desde tu almacenamiento compartido. -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Permite que la aplicación se ejecute automáticamente una vez que el sistema se haya iniciado completamente. Esto puede hacer que el teléfono tarde más en iniciarse y puede permitir que la aplicación ralentice el funcionamiento global del dispositivo. -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Permite que la aplicación controle la función de vibración. -->
    <uses-permission
        android:name="android.permission.VIBRATE" />
    <!-- Permite que la aplicación use servicios en primer plano. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Permite que la aplicación use servicios en primer plano con el tipo "mediaPlayback" -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Permite que la aplicación muestre las notificaciones como actividades de pantalla completa en un dispositivo bloqueado -->
    <uses-permission
        android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Esta aplicación puede programar tareas para que se realicen en un momento posterior determinado. Esto también implica que la aplicación puede ejecutarse cuando no estés usando el dispositivo de manera activa. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Permite que la aplicación muestre notificaciones -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Permite que una aplicación solicite permiso para ignorar las optimizaciones de la batería. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <application
        android:theme="@android:style/Theme.Material"
        android:label="@string/app_name"
        android:icon="@mipmap/alarm_klock"
        android:allowBackup="false"
        android:extractNativeLibs="false">
        <activity
            android:name="com.angrydoughnuts.android.alarmclock.AlarmClockActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action
                    android:name="android.intent.action.MAIN" />
                <category
                    android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name="com.angrydoughnuts.android.alarmclock.AlarmNotificationService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <receiver
            android:name="com.angrydoughnuts.android.alarmclock.AlarmNotificationService$AlarmTriggerReceiver" />
        <receiver
            android:name="com.angrydoughnuts.android.alarmclock.CountdownRefresh" />
        <receiver
            android:name="com.angrydoughnuts.android.alarmclock.SystemMessageReceiver"
            android:exported="false">
            <intent-filter>
                <action
                    android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action
                    android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action
                    android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <provider
            android:name="com.angrydoughnuts.android.alarmclock.AlarmClockProvider"
            android:exported="false"
            android:authorities="com.angrydoughnuts.android.alarmclock.provider" />
        <activity
            android:name="com.angrydoughnuts.android.alarmclock.AlarmNotificationActivity"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:screenOrientation="portrait" />
        <activity
            android:label="@string/mode_stopwatch"
            android:name="com.angrydoughnuts.android.alarmclock.StopwatchActivity"
            android:exported="false" />
        <activity
            android:label="@string/mode_timer"
            android:name="com.angrydoughnuts.android.alarmclock.TimerActivity"
            android:exported="false" />
    </application>
</manifest>